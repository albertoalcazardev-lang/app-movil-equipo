<?xml version="1.0" encoding="utf-8"?>
<!--
    PANTALLA: Mi cuenta (US02 - mockup 14)

    Esta pantalla es un "puente" temporal: la usamos para demostrar
    el cierre de sesión mientras el resto del equipo conecta el
    catálogo real (US03-US12). Cuando ellos terminen, esta pantalla
    puede convertirse en la pestaña "Mi cuenta" dentro de su navegación
    inferior; el código de cerrar sesión no cambia.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Texto.Titulo"
            android:textSize="24sp"
            android:text="@string/titulo_mi_cuenta"
            android:layout_marginBottom="20dp" />

        <!-- ============== Tarjeta de usuario ============== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/fondo_tarjeta"
            android:padding="20dp"
            android:layout_marginBottom="18dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/fondo_avatar"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/texto_iniciales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/color_confianza"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:contentDescription="@string/descripcion_avatar"
                    tools:ignore="HardcodedText"
                    tools:text="LT" />
            </FrameLayout>

            <TextView
                android:id="@+id/texto_nombre_completo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_texto"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Lucía Torres" />

            <TextView
                android:id="@+id/texto_usuario_arroba"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_texto_secundario"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"
                tools:text="@usuario" />

            <TextView
                android:id="@+id/chip_rol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_avatar"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/color_confianza"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Cliente" />
        </LinearLayout>

        <!-- ============== Datos de la sesión ============== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <include layout="@layout/fila_dato" android:id="@+id/fila_id" />
            <include layout="@layout/fila_dato" android:id="@+id/fila_rol" />
            <include layout="@layout/fila_dato" android:id="@+id/fila_sesion" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nota_cerrar_sesion"
            android:textColor="@color/color_texto_secundario"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- ============== Botón Cerrar sesión ============== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_cerrar_sesion"
            style="@style/Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/boton_cerrar_sesion"
            app:icon="@drawable/ic_flecha"
            app:iconTint="@color/color_confianza"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />
    </LinearLayout>
</ScrollView>