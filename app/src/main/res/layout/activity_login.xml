<?xml version="1.0" encoding="utf-8"?>
<!--
    PANTALLA: Iniciar sesión (US01)

    Esta única pantalla representa los mockups 01, 02 y 03 del PDF:
      - Mockup 01: estado normal (banner_estado en GONE)
      - Mockup 02: credenciales incorrectas (banner_estado VISIBLE, texto rojo)
      - Mockup 03: sin conexión (banner_estado VISIBLE, texto de red)
    El estado se cambia por código Java, no se crean 3 layouts distintos,
    porque es la MISMA pantalla, solo cambia el mensaje.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/color_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ============== Marca ============== -->
        <TextView
            android:id="@+id/texto_marca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="nova·"
            android:textColor="@color/color_confianza"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- ============== Banner de ilustración ============== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/fondo_ilustracion"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/circulo_apoyo" />

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mochila"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- ============== Textos de bienvenida ============== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Texto.EtiquetaOjo"
            android:text="@string/etiqueta_ojo"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Texto.Titulo"
            android:text="@string/titulo_login"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Texto.Subtitulo"
            android:text="@string/subtitulo_login"
            android:layout_marginBottom="16dp" />

        <!-- ============== Banner de estado (error / sin conexión) ==============
             Oculto por defecto (android:visibility="gone"). Se muestra desde
             Java con banner_estado.setVisibility(View.VISIBLE) -->
        <LinearLayout
            android:id="@+id/banner_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fondo_banner_error"
            android:padding="14dp"
            android:visibility="gone"
            android:layout_marginBottom="14dp"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_error"
                android:contentDescription="@string/descripcion_icono_error"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/texto_banner_estado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color_error_texto"
                android:textSize="14sp"
                tools:text="@string/error_credenciales" />
        </LinearLayout>

        <!-- ============== Campo: usuario ============== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Texto.Etiqueta"
            android:text="@string/campo_usuario"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/contenedor_usuario"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campo_usuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/campo_usuario_ayuda"
                android:inputType="text"
                android:textColor="@color/color_texto"
                android:textStyle="bold"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ============== Campo: contraseña ============== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Texto.Etiqueta"
            android:text="@string/campo_contrasena"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/contenedor_contrasena"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            android:layout_marginBottom="22dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campo_contrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/campo_contrasena_ayuda"
                android:inputType="textPassword"
                android:textColor="@color/color_texto"
                android:textStyle="bold"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ============== Botón Iniciar sesión ============== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_iniciar_sesion"
            style="@style/Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/boton_iniciar_sesion"
            app:icon="@drawable/ic_flecha"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <!-- Barra de progreso mientras se consulta la API. Oculta por defecto. -->
        <ProgressBar
            android:id="@+id/barra_progreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:indeterminateTint="@color/color_accion"
            tools:visibility="visible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:text="@string/pie_login"
            android:textColor="@color/color_texto_secundario"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>